---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';

const reviews = [
  { quote: 'Приехали вовремя, всё чётко объяснили и завершили работу быстрее, чем ожидалось. Лучший сервис, с которым мы сталкивались.', name: 'Анна С.', location: 'Москва', rating: 5 },
  { quote: 'Честные цены и отличная работа. Пользуюсь их услугами уже для трёх разных проектов, и они ни разу не разочаровали.', name: 'Сергей К.', location: 'Санкт-Петербург', rating: 5 },
  { quote: 'На наш аварийный вызов ответили через несколько минут. Устранили проблему до ужина. Настоящая надёжность.', name: 'Елена М.', location: 'Москва', rating: 5 },
  { quote: 'Результат ремонта превзошёл все ожидания. Профессионально, чисто и в рамках бюджета. Мы не можем быть счастливее.', name: 'Олег и Татьяна П.', location: 'Подмосковье', rating: 5 },
  { quote: 'Отличная коммуникация от начала до конца. Присылали фото хода работ и идеально убрали после завершения.', name: 'Наталья В.', location: 'Москва', rating: 5 },
  { quote: 'Ценю прозрачное ценообразование — никаких скрытых комиссий или сюрпризов. Редко сейчас встретишь. Настоятельно рекомендую.', name: 'Андрей Д.', location: 'Химки', rating: 5 },
];
---

<BaseLayout
  title="Отзывы"
  description={`Прочитайте отзывы и тестимониалы от клиентов ${brand.name}. Узнайте, почему домовладельцы доверяют нам свои проекты.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: client.name,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      reviewCount: String(reviews.length),
      bestRating: '5',
    },
  }}
>
  <Header slot="header" />

  <Banner title="Отзывы клиентов" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Что говорят клиенты</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Не верьте нам на слово — послушайте домовладельцев, которым мы помогли.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {reviews.map(({ quote, name, location, rating = 5 }) => (
          <div class="flex flex-col rounded-lg border border-border bg-background p-6 shadow-sm">
            <div class="mb-4 flex gap-0.5" aria-label={`Rated ${rating} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class:list={['size-5', i < rating ? 'text-accent' : 'text-border']}
                  fill="currentColor"
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="flex-1 text-text-muted leading-relaxed">
              &ldquo;{quote}&rdquo;
            </blockquote>
            <div class="mt-4 border-t border-border pt-4">
              <p class="font-semibold text-text">{name}</p>
              <p class="text-sm text-text-muted">{location}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
